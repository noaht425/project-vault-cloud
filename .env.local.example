# Copy this file to .env.local and fill in real values.
# Create a new Supabase project at supabase.com (a separate project from
# A Bent Fork's — this is a different app with different data) then find
# these in: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, dev-server-only convenience — lets GET /api/dev-login sign you
# into a throwaway account without typing a password each restart. Inert
# unless ENABLE_DEV_LOGIN=true is set too (belt-and-suspenders on top of
# only working under `next dev` in the first place — see
# src/app/api/dev-login/route.ts). Create the account yourself via the
# normal Sign Up page first.
# ENABLE_DEV_LOGIN=true
# DEV_LOGIN_EMAIL=
# DEV_LOGIN_PASSWORD=
